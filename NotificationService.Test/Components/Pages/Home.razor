@page "/"

<h1>Hello, world!</h1>
Welcome to your new app.

@if (ComponentType is not null)
{
    <DynamicComponent  Type="ComponentType"/>
}

@code{

    private Type ComponentType { get; set; }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return Task.CompletedTask;

        #if ANDROID
        ComponentType = typeof(NotificationService.Test.Components.AndroidNotificationComponent);
        #endif
        #if WINDOWS
        ComponentType = typeof(NotificationService.Test.Components.WindowsNotificationComponent);
        #endif
        return InvokeAsync(StateHasChanged);
    }
}